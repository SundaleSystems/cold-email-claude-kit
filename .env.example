# Cold Email Claude Kit — environment variables
#
# Copy this file to `.env` (same folder) and fill in ONLY the keys for the tools you use.
# `.env` is git-ignored — never commit it.
# Check which keys work:  npx tsx .claude/skills/cold-email-starter-kit/scripts/verify-credentials.ts

# ============================================================
# CORE — needed for almost everything
# ============================================================
# Instantly (sending platform) — https://instantly.ai
# Settings → Integrations → API Keys → create an API v2 key with all scopes.
INSTANTLY_API_KEY=

# LeadMagic (email finding + validation) — https://leadmagic.io
# Dashboard → API → copy the key.
LEADMAGIC_API_KEY=

# MillionVerifier (bulk email verification) — https://www.millionverifier.com
MILLIONVERIFIER_API_KEY=

# ============================================================
# SENDER IDENTITY — used for inbox signatures and from-names
# ============================================================
SENDER_FIRST_NAME=
SENDER_LAST_NAME=
SENDER_TITLE=
SENDER_COMPANY_NAME=
SENDER_WEBSITE=
SENDER_PHYSICAL_ADDRESS=

# ============================================================
# INFRASTRUCTURE — only if you buy domains / create inboxes with the kit
# ============================================================
# Dynadot (domains) — https://www.dynadot.com  (Account → Tools → API)
DYNADOT_API_KEY=
# Zapmail (inboxes) — https://zapmail.ai  (Account → API)
ZAPMAIL_API_KEY=

# ============================================================
# OPTIONAL — other list sources
# ============================================================
# Lead sourcing via Sales Navigator uses the Vayne MCP server (no key here — see README).
BLITZ_API_KEY=
BLITZ_BASE_URL=
DISCOLIKE_API_KEY=
# RapidAPI (Google Maps scraping) — subscribe to "Maps Data API"
RAPIDAPI_KEY=
# OpenRouter / OpenWebNinja — only for the starter-kit enrichment scripts
OPENROUTER_API_KEY=
OPENWEBNINJA_KEY=

# ============================================================
# OPTIONAL — account-manager (daily automation) + Slack alerts
# ============================================================
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=

# ============================================================
# OPTIONAL — reply-gate / phone-hunt (Supabase edge functions)
# Server-side secrets for those functions go in their own secrets.example files.
# ============================================================
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
ANTHROPIC_API_KEY=
CALENDLY_API_KEY=
INSTANTLY_WEBHOOK_SECRET=
APIFY_TOKEN=
PHONE_HUNT_WEBHOOK_SECRET=

# SPEED TO CALL (phone-hunt) — Supabase Edge Function secrets.
# NEVER put these in a repo file or paste them into a chat.
# Set them in: Supabase Dashboard > Edge Functions > Secrets
# or: supabase secrets set NAME=value --project-ref <your-project-ref>
#
# INSTANTLY_API_KEY, SLACK_BOT_TOKEN and SLACK_ALERT_CHANNEL are already
# set in the "Speed to Lead" project for reply-gate — this function reuses
# them, so you only add the NEW ones below.

PHONE_HUNT_WEBHOOK_SECRET=    # a long random password you invent; goes on THIS function's webhook URL (separate from reply-gate's)
APIFY_TOKEN=                  # apify.com > Settings > Integrations > Personal API token
LEADMAGIC_API_KEY=            # same key as the root .env; optional — without it the LeadMagic source is skipped

# --- optional: email-to-self alerts (all three, or the channel stays off) ---
GMAIL_CLIENT_ID=             # Google Cloud OAuth 2.0 client (Desktop app) — see README "Email alerts"
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=         # minted once with the gmail.send scope + offline access
ALERT_EMAIL_TO=you@yourcompany.com   # optional override (default is this)

# --- optional tunables (defaults shown) ---
APIFY_MAX_RECORDS=3
APIFY_MAX_CHARGE_USD=1
APIFY_TIMEOUT_MS=60000
# APIFY_FPS_ACTOR / APIFY_TPS_ACTOR override the default actor slugs if needed.

# Already in the project (do NOT re-add): INSTANTLY_API_KEY, SLACK_BOT_TOKEN,
# SLACK_ALERT_CHANNEL. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided
# automatically by the Supabase edge runtime.

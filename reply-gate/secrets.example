# Reply Gate — Supabase Edge Function secrets.
# These are NEVER put in a file in this repo or pasted into a chat.
# Set them in: Supabase Dashboard > Edge Functions > Secrets
# or: supabase secrets set NAME=value
#
# The service role key and the Instantly key deserve respect: one
# bypasses every database permission, the other can send mail as you.
# If either ever leaks, rotate it that day.

INSTANTLY_API_KEY=            # Instantly > Settings > Integrations > API Keys (v2 key)
ANTHROPIC_API_KEY=            # console.anthropic.com — pay-per-use, separate from a Claude subscription
CALENDLY_API_KEY=             # Calendly > Integrations > API & Webhooks > Personal Access Token
CALENDLY_EVENT_TYPE_SLUG=     # optional: which event type's slots to offer (default: first active)
SLACK_BOT_TOKEN=              # xoxb-... bot token with chat:write, invited to the channel
SLACK_ALERT_CHANNEL=          # channel ID (C0...) of your reply-gate channel
INSTANTLY_WEBHOOK_SECRET=     # a long random password you invent; goes on the webhook URL
SHADOW_MODE=true              # leave true until the drafts stop teaching you anything
CONFIDENCE_THRESHOLD=0.8
SEND_DELAY_MINUTES=4
DRAFT_MODEL=claude-sonnet-5
VERIFY_MODEL=claude-sonnet-5
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically
# by the Supabase edge runtime — you do not set them yourself.
